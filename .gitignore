# Keep CI configuration and its helper script versioned despite the broad
# hidden-file and build-artifact ignore rules above.
!.github/
!.github/workflows/
!.github/workflows/ci.yml
!scripts/build_native_dependencies.sh

# Keep the conventional Python unit-test suite versioned.
!tests/test_*.py
!tests/_base.py
!tests/__init__.py
!tests/__main__.py
